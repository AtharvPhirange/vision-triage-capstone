    <string name="guide_header_title">Guía del Usuario Clínico</string>
    <string name="guide_header_subtitle">Operación paso a paso y flujo de diagnóstico</string>
    <string name="guide_title">Guía del Usuario Clínico</string>
    <string name="guide_subtitle">Operación paso a paso y flujo de diagnóstico</string>
    <string name="guide_step1_badge">PASO 1 - VISIÓN GENERAL</string>
    <string name="guide_step1_title">Descripción de App y Portales</string>
    <string name="guide_step1_desc">Vision Triage conecta a pacientes, técnicos y consultores en un flujo unificado. Seleccione su rol en el panel principal.</string>
    <string name="guide_step1_bullet1">• Flujo de Roles (Paciente / Técnico / Médico)</string>
    <string name="guide_step1_bullet2">• Seguridad Local HIPAA y ABDM</string>
    <string name="guide_step1_item4_title">Datos Seguros y Locales</string>
    <string name="guide_step1_item4_desc">Sus datos de salud nunca salen de su dispositivo sin su consentimiento explícito.</string>

    <string name="guide_step2_badge">PASO 2</string>
    <string name="guide_step2_title">Cómo Escanear</string>
    <string name="guide_step2_desc">Coloque la cámara a 25-30 cm del ojo del paciente. Garantice iluminación uniforme y bloquee la retícula en la pupila.</string>
    <string name="guide_step2_bullet1">• Bloqueo de Objetivo a 25–30 cm</string>
    <string name="guide_step2_bullet2">• Alineación de Retícula en Pupila</string>
    <string name="guide_step2_item1_title">Bloqueo de Distancia</string>
    <string name="guide_step2_item1_desc">Mantenga una distancia constante de 25-30 cm del ojo del paciente.</string>
    <string name="guide_step2_item2_title">Objetivo Estético</string>
    <string name="guide_step2_item2_desc">Alinee la retícula precisamente en el centro pupilar.</string>
    <string name="guide_step2_item3_title">Control de Iluminación</string>
    <string name="guide_step2_item3_desc">Asegure iluminación uniforme sin reflejos deslumbrantes.</string>
    <string name="guide_step2_item4_title">Bloqueo de Detección</string>
    <string name="guide_step2_item4_desc">Asegure que la confianza de seguimiento IA sea superior al 95%.</string>

    <string name="guide_step3_badge">PASO 3</string>
    <string name="guide_step3_title">Capturar PLR</string>
    <string name="guide_step3_desc">Ejecute el escaneo automatizado de 5 segundos. Mantenga las manos firmes hasta alcanzar más del 95% de confianza IA.</string>
    <string name="guide_step3_bullet1">• Barrido Automatizado de 5s</string>
    <string name="guide_step3_bullet2">• Umbral de Confianza IA 95%+</string>
    <string name="guide_step3_item1_title">Registro Basal</string>
    <string name="guide_step3_item1_desc">Captura el diámetro pupilar en reposo durante el primer segundo.</string>
    <string name="guide_step3_item2_title">Estimulación Lumínica</string>
    <string name="guide_step3_item2_desc">Emite pulso de luz controlado para observar la velocidad de constricción.</string>
    <string name="guide_step3_item3_title">Rastreo de Recuperación</string>
    <string name="guide_step3_item3_desc">Mide velocidad de redilatation y curvas de latencia.</string>
    <string name="guide_step3_item4_title">Verificación de Calidad</string>
    <string name="guide_step3_item4_desc">Guarda el registro cuando alcanza el umbral de 95%+ de confianza.</string>

    <string name="guide_step4_badge">PASO 4</string>
    <string name="guide_step4_title">Verificar Estado</string>
    <string name="guide_step4_desc">Clasificación inmediata: Verde (Normal), Ámbar (Observación) o Rojo (Urgente). Vea gráficos de latencia en historial.</string>
    <string name="guide_step4_bullet1">• Clasificación de Riesgo Tricolor</string>
    <string name="guide_step4_bullet2">• Gráficos de Latencia Kinemática</string>
    <string name="guide_step4_item1_title">Verde (Normal)</string>
    <string name="guide_step4_item1_desc">Respuesta pupilar simétrica con velocidad normal.</string>
    <string name="guide_step4_item2_title">Ámbar (Observación)</string>
    <string name="guide_step4_item2_desc">Reflejo perezoso o ligera asimetría que requiere seguimiento.</string>
    <string name="guide_step4_item3_title">Rojo (Urgente)</string>
    <string name="guide_step4_item3_desc">Pupila fija, dilatada o no reactiva que requiere escalamiento.</string>
    <string name="guide_step4_item4_title">Gráficos de Latencia</string>
    <string name="guide_step4_item4_desc">Acceda a formas de onda de latencia PLR en Historial Médico.</string>

    <string name="guide_step5_badge">PASO 5</string>
    <string name="guide_step5_title">Revisión del Consultor</string>
    <string name="guide_step5_desc">Escale casos de alto riesgo directamente a la cola del consultor en un toque para verificación teleoftalmológica.</string>
    <string name="guide_step5_bullet1">• Escalamiento de Cola en 1 Toque</string>
    <string name="guide_step5_bullet2">• Verificación Teleoftalmológica</string>
    <string name="guide_step5_item1_title">Marcar Alto Riesgo</string>
    <string name="guide_step5_item1_desc">Casos rojos entran automáticamente en la cola de revisión.</string>
    <string name="guide_step5_item2_title">Análisis de Onda</string>
    <string name="guide_step5_item2_desc">Consultores revisan gráficos PLR de alta frecuencia.</string>
    <string name="guide_step5_item3_title">Etiqueta de Verificación</string>
    <string name="guide_step5_item3_desc">Añada notas clínicas y firme informes de diagnóstico.</string>
    <string name="guide_step5_item4_title">Envío a Paciente</string>
    <string name="guide_step5_item4_desc">Envíe el resumen de triaje directamente al perfil del paciente.</string>

