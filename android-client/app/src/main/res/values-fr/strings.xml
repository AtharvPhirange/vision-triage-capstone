    <string name="guide_header_title">Guide de l\'Utilisateur Clinique</string>
    <string name="guide_header_subtitle">Procédure étape par étape et diagnostic</string>
    <string name="guide_title">Guide de l\'Utilisateur Clinique</string>
    <string name="guide_subtitle">Procédure étape par étape et diagnostic</string>
    <string name="guide_step1_badge">ÉTAPE 1 - APERÇU</string>
    <string name="guide_step1_title">Aperçu de l\'App et Portails</string>
    <string name="guide_step1_desc">Vision Triage relie patients, techniciens et consultants dans un flux unique. Sélectionnez votre rôle dans le tableau de bord.</string>
    <string name="guide_step1_bullet1">• Flux des Rôles (Patient / Tech / Médecin)</string>
    <string name="guide_step1_bullet2">• Sécurité Locale HIPAA et ABDM</string>
    <string name="guide_step1_item4_title">Données Sécurisées et Locales</string>
    <string name="guide_step1_item4_desc">Vos données de santé ne quittent jamais votre appareil sans votre consentement explicite.</string>

    <string name="guide_step2_badge">ÉTAPE 2</string>
    <string name="guide_step2_title">Comment Examiner</string>
    <string name="guide_step2_desc">Positionnez la caméra à 25-30 cm de l\'œil du patient. Assurez un éclairage uniforme et verrouillez le réticule sur la pupille.</string>
    <string name="guide_step2_bullet1">• Verrouillage Cible à 25–30 cm</string>
    <string name="guide_step2_bullet2">• Alignement du Réticule Pupillaire</string>
    <string name="guide_step2_item1_title">Verrouillage de Distance</string>
    <string name="guide_step2_item1_desc">Maintenez un écart constant de 25-30 cm de l\'œil du patient.</string>
    <string name="guide_step2_item2_title">Cible Précise</string>
    <string name="guide_step2_item2_desc">Alignez le réticule précisément au centre de la pupille.</string>
    <string name="guide_step2_item3_title">Contrôle de l\'Éclairage</string>
    <string name="guide_step2_item3_desc">Assurez un éclairage ambiant uniforme sans reflets.</string>
    <string name="guide_step2_item4_title">Verrouillage de Détection</string>
    <string name="guide_step2_item4_desc">Assurez-vous que la confiance IA reste supérieure à 95%.</string>

    <string name="guide_step3_badge">ÉTAPE 3</string>
    <string name="guide_step3_title">Capturer le PLR</string>
    <string name="guide_step3_desc">Exécutez le balayage automatisé de 5 secondes. Gardez les mains stables jusqu\'à dépasser 95% de confiance IA.</string>
    <string name="guide_step3_bullet1">• Balayage Automatisé de 5s</string>
    <string name="guide_step3_bullet2">• Seuil de Confiance IA 95%+</string>
    <string name="guide_step3_item1_title">Enregistrement Initial</string>
    <string name="guide_step3_item1_desc">Capture le diamètre pupillaire au repos pendant la première seconde.</string>
    <string name="guide_step3_item2_title">Stimulation Lumineuse</string>
    <string name="guide_step3_item2_desc">Émet une impulsion lumineuse contrôlée pour observer la vitesse de constriction.</string>
    <string name="guide_step3_item3_title">Suivi de Récupération</string>
    <string name="guide_step3_item3_desc">Mesure la vitesse de redilatation et les courbes de latence.</string>
    <string name="guide_step3_item4_title">Vérification de Qualité</string>
    <string name="guide_step3_item4_desc">Enregistre lorsque la confiance atteint le seuil de 95%+.</string>

    <string name="guide_step4_badge">ÉTAPE 4</string>
    <string name="guide_step4_title">Vérifier le Statut</string>
    <string name="guide_step4_desc">Classification immédiate : Vert (Normal), Ambre (Observation) ou Rouge (Urgent). Consultez les graphiques dans l\'historique.</string>
    <string name="guide_step4_bullet1">• Classification de Risque Tricolore</string>
    <string name="guide_step4_bullet2">• Graphiques de Latence Cinématique</string>
    <string name="guide_step4_item1_title">Vert (Normal)</string>
    <string name="guide_step4_item1_desc">Réponse pupillaire symétrique avec vitesse normale.</string>
    <string name="guide_step4_item2_title">Ambre (Observation)</string>
    <string name="guide_step4_item2_desc">Réflexe lent ou légere métrie nécessitant un suivi.</string>
    <string name="guide_step4_item3_title">Rouge (Urgent)</string>
    <string name="guide_step4_item3_desc">Pupille fixe, dilatée ou aréactive nécessitant une escalade.</string>
    <string name="guide_step4_item4_title">Graphiques de Latence</string>
    <string name="guide_step4_item4_desc">Accédez aux formes d\'onde PLR dans l\'Historique Médical.</string>

    <string name="guide_step5_badge">ÉTAPE 5</string>
    <string name="guide_step5_title">Examen Consultant</string>
    <string name="guide_step5_desc">Escalader les cas à haut risque directement vers la file du consultant en un tap pour vérification télé-ophtalmologique.</string>
    <string name="guide_step5_bullet1">• Escalade en 1 Clic</string>
    <string name="guide_step5_bullet2">• Vérification Télé-Ophtalmologique</string>
    <string name="guide_step5_item1_title">Signaler Haut Risque</string>
    <string name="guide_step5_item1_desc">Les cas rouges entrent automatiquement dans la file d\'examen.</string>
    <string name="guide_step5_item2_title">Analyse de Forme d\'Onde</string>
    <string name="guide_step5_item2_desc">Les consultants examinent les graphiques PLR haute fréquence.</string>
    <string name="guide_step5_item3_title">Valider le Diagnostic</string>
    <string name="guide_step5_item3_desc">Ajoutez des notes cliniques et signez le rapport.</string>
    <string name="guide_step5_item4_title">Transmission au Patient</string>
    <string name="guide_step5_item4_desc">Envoyez le résumé du tri directement au profil du patient.</string>

