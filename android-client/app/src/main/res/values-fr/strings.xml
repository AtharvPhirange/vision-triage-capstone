    <string-array name="clinical_eye_tips">
        <item>Incorporez des légumes feuillus riches en lutéine et zéaxanthine pour protéger la densité pigmentaire maculaire.</item>
        <item>Appliquez la règle 20-20-20 : toutes les 20 minutes, fixez un objet à 20 pieds pendant 20 secondes.</item>
        <item>Placez les écrans 15 à 20 degrés sous le niveau des yeux pour réduire l\'évaporation du film lacrymal.</item>
        <item>Assurez un éclairage ambiant à haut contraste pour éviter la fatigue pupillaire.</item>
        <item>Portez des lunettes de protection certifiées UV400 pendant la journée contre la cataracte.</item>
    </string-array>

    <string-array name="clinical_eye_tips_detailed">
        <item>Incorporez des légumes feuillus riches en lutéine et zéaxanthine pour protéger la densité pigmentaire maculaire.</item>
        <item>Appliquez la règle 20-20-20 : toutes les 20 minutes, fixez un objet à 20 pieds pendant 20 secondes.</item>
        <item>Placez les écrans 15 à 20 degrés sous le niveau des yeux pour réduire l\'évaporation du film lacrymal.</item>
        <item>Assurez un éclairage ambiant à haut contraste pour éviter la fatigue pupillaire.</item>
        <item>Portez des lunettes de protection certifiées UV400 pendant la journée contre la cataracte.</item>
    </string-array>

