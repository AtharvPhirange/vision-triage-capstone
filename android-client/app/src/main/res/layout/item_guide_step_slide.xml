<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header Area -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp">

            <TextView
                android:id="@+id/tvSlideBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pill_badge"
                android:letterSpacing="0.05"
                android:paddingHorizontal="14dp"
                android:paddingVertical="6dp"
                android:textColor="#0284C7"
                android:textSize="13sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:text="STEP 1 - OVERVIEW" />

            <TextView
                android:id="@+id/tvSlideTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:textColor="#0A192F"
                android:textSize="24sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvSlideBadge"
                tools:text="App Overview &amp; Portals" />

            <TextView
                android:id="@+id/tvSlideCaption"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:lineSpacingMultiplier="1.25"
                android:textColor="#475569"
                android:textSize="15sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvSlideTitle"
                tools:text="Unified clinical pipeline connecting three key roles" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginBottom="18dp"
            android:background="#E2E8F0" />

        <!-- Sub-Steps Container -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Sub-Step 1 -->
            <LinearLayout
                android:id="@+id/containerSubStep1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="18dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvNum1"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginEnd="14dp"
                    android:background="@drawable/bg_bubble_circle"
                    android:backgroundTint="#E0F2FE"
                    android:gravity="center"
                    android:text="@string/num_1"
                    android:textColor="#0284C7"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvSubTitle1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#0F172A"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        tools:text="Patient Portal" />

                    <TextView
                        android:id="@+id/tvSubDesc1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:lineSpacingMultiplier="1.2"
                        android:textColor="#64748B"
                        android:textSize="14sp"
                        tools:text="Self-service medical history, scan records, and appointment requests." />
                </LinearLayout>
            </LinearLayout>

            <!-- Sub-Step 2 -->
            <LinearLayout
                android:id="@+id/containerSubStep2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="18dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvNum2"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginEnd="14dp"
                    android:background="@drawable/bg_bubble_circle"
                    android:backgroundTint="#EEF2FF"
                    android:gravity="center"
                    android:text="@string/num_2"
                    android:textColor="#6366F1"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvSubTitle2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#0F172A"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        tools:text="Technician Portal" />

                    <TextView
                        android:id="@+id/tvSubDesc2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:lineSpacingMultiplier="1.2"
                        android:textColor="#64748B"
                        android:textSize="14sp"
                        tools:text="Hardware pupillometry capture, intake forms, and offline sync." />
                </LinearLayout>
            </LinearLayout>

            <!-- Sub-Step 3 -->
            <LinearLayout
                android:id="@+id/containerSubStep3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="18dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvNum3"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginEnd="14dp"
                    android:background="@drawable/bg_bubble_circle"
                    android:backgroundTint="#FFF7ED"
                    android:gravity="center"
                    android:text="@string/num_3"
                    android:textColor="#EA580C"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvSubTitle3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#0F172A"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        tools:text="Consultant Portal" />

                    <TextView
                        android:id="@+id/tvSubDesc3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:lineSpacingMultiplier="1.2"
                        android:textColor="#64748B"
                        android:textSize="14sp"
                        tools:text="Priority review queue, PLR latency graphs, and risk triage." />
                </LinearLayout>
            </LinearLayout>

            <!-- Sub-Step 4 -->
            <LinearLayout
                android:id="@+id/containerSubStep4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="18dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvNum4"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginEnd="14dp"
                    android:background="@drawable/bg_bubble_circle"
                    android:backgroundTint="#F0FDF4"
                    android:gravity="center"
                    android:text="@string/num_4"
                    android:textColor="#16A34A"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvSubTitle4"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#0F172A"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        tools:text="Secure Pipeline" />

                    <TextView
                        android:id="@+id/tvSubDesc4"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:lineSpacingMultiplier="1.2"
                        android:textColor="#64748B"
                        android:textSize="14sp"
                        tools:text="On-device processing with optional HIPAA/ABDM sync." />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>