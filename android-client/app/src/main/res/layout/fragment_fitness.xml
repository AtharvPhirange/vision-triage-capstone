<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0A1628">

    <!-- Screen Title Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="10dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ocular Health &amp; Eye Exercises"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="Live medical-grade exercise &amp; fatigue reset feed"
            android:textColor="#94A3B8"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Horizontal Category Chips -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:paddingHorizontal="16dp"
        android:paddingBottom="10dp">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroupFilters"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipAll"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="All Ocular"
                app:chipBackgroundColor="@color/selector_chip_bg"
                app:chipCornerRadius="16dp"
                android:textColor="#FFFFFF" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipStrain"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="20-20-20 Rule &amp; Strain"
                app:chipBackgroundColor="@color/selector_chip_bg"
                app:chipCornerRadius="16dp"
                android:textColor="#FFFFFF" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipMobility"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Eye Mobility &amp; Yoga"
                app:chipBackgroundColor="@color/selector_chip_bg"
                app:chipCornerRadius="16dp"
                android:textColor="#FFFFFF" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipDryEye"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Dry Eyes &amp; Palming"
                app:chipBackgroundColor="@color/selector_chip_bg"
                app:chipCornerRadius="16dp"
                android:textColor="#FFFFFF" />
        </com.google.android.material.chip.ChipGroup>
    </HorizontalScrollView>

    <!-- Swipe to Refresh & Endless Recycler -->
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefreshFitness"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerFitnessFeed"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="100dp" />
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
</LinearLayout>