<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    app:cardBackgroundColor="#000000"
    app:cardCornerRadius="20dp"
    app:cardElevation="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Embedded YouTube HTML5 Player Frame -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="240dp">

            <WebView
                android:id="@+id/youtubePlayerView"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <ProgressBar
                android:id="@+id/videoLoadingProgress"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="center"
                android:indeterminateTint="#0284C7" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#0F172A"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:id="@+id/tvVideoTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:textStyle="bold"
                tools:text="20-20-20 Ocular Reset Rule" />

            <TextView
                android:id="@+id/tvVideoDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:lineSpacingMultiplier="1.2"
                android:textColor="#94A3B8"
                android:textSize="13sp"
                tools:text="Rests ciliary muscles and prevents accommodation fatigue after screen exposure." />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnClosePlayer"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="16dp"
                android:text="@string/btn_cancel"
                android:textAllCaps="false"
                android:textColor="#0284C7"
                android:textSize="14sp"
                android:textStyle="bold"
                app:cornerRadius="24dp"
                app:strokeColor="#0284C7"
                app:strokeWidth="1.5dp" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>