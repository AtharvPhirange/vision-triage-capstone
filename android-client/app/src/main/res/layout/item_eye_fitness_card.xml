<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginBottom="16dp"
    app:cardBackgroundColor="#FFFFFF"
    app:cardCornerRadius="20dp"
    app:cardElevation="4dp"
    app:strokeColor="#E2E8F0"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Top Media Thumbnail Frame -->
        <FrameLayout
            android:id="@+id/frameThumbnail"
            android:layout_width="match_parent"
            android:layout_height="160dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/ivVideoThumbnail"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/bg_thumbnail_placeholder"
                app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.App.TopCornerSize20dp" />

            <!-- Centered Play Overlay Button Badge -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="center"
                app:cardBackgroundColor="#DC2626"
                app:cardCornerRadius="24dp"
                app:cardElevation="6dp"
                app:strokeWidth="0dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:contentDescription="Play Video"
                    android:src="@drawable/ic_play_arrow"
                    app:tint="#FFFFFF" />
            </com.google.android.material.card.MaterialCardView>

            <!-- Bottom-Right Duration Tag Overlay -->
            <TextView
                android:id="@+id/tvDurationTag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|end"
                android:layout_margin="12dp"
                android:background="@drawable/bg_pill_badge"
                android:backgroundTint="#CC0A192F"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold"
                tools:text="3 Mins" />
        </FrameLayout>

        <!-- Bottom Content & Action Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/tvVideoTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#0F172A"
                android:textSize="16sp"
                android:textStyle="bold"
                tools:text="20-20-20 Ocular Reset Rule" />

            <TextView
                android:id="@+id/tvVideoDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:lineSpacingMultiplier="1.2"
                android:maxLines="2"
                android:textColor="#64748B"
                android:textSize="13sp"
                tools:text="Rests ciliary muscles and prevents accommodation fatigue after screen exposure." />

            <TextView
                android:id="@+id/tvCategoryPill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_pill_badge"
                android:backgroundTint="#FEF2F2"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:textColor="#DC2626"
                android:textSize="11sp"
                android:textStyle="bold"
                tools:text="EYE STRAIN" />

            <!-- Single Full-Width YouTube Action Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnWatchYouTube"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="12dp"
                android:text="@string/btn_watch_on_youtube"
                android:textAllCaps="false"
                android:textColor="#DC2626"
                android:textSize="14sp"
                android:textStyle="bold"
                app:cornerRadius="25dp"
                app:icon="@drawable/ic_youtube_official"
                app:iconGravity="textStart"
                app:iconTint="@null"
                app:strokeColor="#DC2626"
                app:strokeWidth="1.5dp" />

        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>