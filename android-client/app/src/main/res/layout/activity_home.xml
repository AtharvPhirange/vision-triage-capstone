<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_dashboard_gradient"
    tools:context=".HomeActivity">

    <!-- Global 60FPS Floating Bio-Ocular Bubbles Background Layer -->
    <com.example.myapplication.FloatingBubbleView
        android:id="@+id/dashboardBubbleBackground"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Layer 1: Top Bar Header Section -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/topBarHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="12dp"
        android:paddingBottom="4dp"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Hamburger Menu (Top-Left) -->
        <ImageView
            android:id="@+id/btnSettings"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="16dp"
            android:clickable="true"
            android:contentDescription="@string/content_desc_settings"
            android:focusable="true"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_menu_bright"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- User Profile Badge Icon (Far Top-Right) -->
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/btnUserProfile"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginEnd="16dp"
            android:clickable="true"
            android:contentDescription="User Profile"
            android:focusable="true"
            android:padding="2dp"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_account_circle"
            app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.App.CornerSize50Percent"
            app:strokeColor="#0284C7"
            app:strokeWidth="1.5dp"
            app:layout_constraintBottom_toBottomOf="@id/btnSettings"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/btnSettings" />

        <!-- Bilingual Language Badge Icon -->
        <ImageView
            android:id="@+id/btnLanguage"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginEnd="8dp"
            android:clickable="true"
            android:contentDescription="Select Language"
            android:focusable="true"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_language_bilingual"
            app:layout_constraintBottom_toBottomOf="@id/btnUserProfile"
            app:layout_constraintEnd_toStartOf="@id/btnUserProfile"
            app:layout_constraintTop_toTopOf="@id/btnUserProfile"
            app:tint="#FFFFFF" />

        <!-- Quick Scanner Button -->
        <ImageButton
            android:id="@+id/btnQuickScanner"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginEnd="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="Launch Rapid Scanner"
            android:focusable="true"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_qr_code_scanner"
            app:layout_constraintBottom_toBottomOf="@id/btnLanguage"
            app:layout_constraintEnd_toStartOf="@id/btnLanguage"
            app:layout_constraintTop_toTopOf="@id/btnLanguage"
            app:tint="#FFFFFF" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Layer 2: Persistent ViewPager2 Viewport (Expands full screen underneath floating bar) -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/dashboardViewPager"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@android:color/transparent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/topBarHeader" />

    <!-- Layer 3: Persistent Floating Samsung Health-Style Bottom Navigation Dock -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/bottomNavDock"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_marginHorizontal="20dp"
        android:layout_marginBottom="20dp"
        app:cardBackgroundColor="#FFFFFF"
        app:cardCornerRadius="32dp"
        app:cardElevation="12dp"
        app:strokeWidth="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:weightSum="5">

            <!-- Tab 1: Home -->
            <LinearLayout
                android:id="@+id/tabNavHome"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/imgNavHome"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:contentDescription="@string/nav_home"
                    android:src="@drawable/ic_nav_home"
                    app:tint="#0284C7" />

                <TextView
                    android:id="@+id/tvNavHome"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/nav_home"
                    android:textColor="#0284C7"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Tab 2: Discover -->
            <LinearLayout
                android:id="@+id/tabNavDiscover"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/imgNavDiscover"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:contentDescription="@string/nav_discover"
                    android:src="@drawable/ic_nav_discover"
                    app:tint="#64748B" />

                <TextView
                    android:id="@+id/tvNavDiscover"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/nav_discover"
                    android:textColor="#64748B"
                    android:textSize="10sp" />
            </LinearLayout>

            <!-- Tab 3: Fitness -->
            <LinearLayout
                android:id="@+id/tabNavFitness"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/imgNavFitness"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:contentDescription="@string/nav_fitness"
                    android:src="@drawable/ic_nav_fitness"
                    app:tint="#64748B" />

                <TextView
                    android:id="@+id/tvNavFitness"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/nav_fitness"
                    android:textColor="#64748B"
                    android:textSize="10sp" />
            </LinearLayout>

            <!-- Tab 4: Guide -->
            <LinearLayout
                android:id="@+id/tabNavGuide"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/imgNavGuide"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:contentDescription="Guide"
                    android:src="@drawable/ic_nav_scan_guide"
                    app:tint="#64748B" />

                <TextView
                    android:id="@+id/tvNavGuide"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Guide"
                    android:textColor="#64748B"
                    android:textSize="10sp" />
            </LinearLayout>

            <!-- Tab 5: My Health -->
            <LinearLayout
                android:id="@+id/tabNavMyHealth"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/imgNavMyHealth"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:contentDescription="@string/nav_my_health"
                    android:src="@drawable/ic_nav_my_health"
                    app:tint="#64748B" />

                <TextView
                    android:id="@+id/tvNavMyHealth"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/nav_my_health"
                    android:textColor="#64748B"
                    android:textSize="10sp" />
            </LinearLayout>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>