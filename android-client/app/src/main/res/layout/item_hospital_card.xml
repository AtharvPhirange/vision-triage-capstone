<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="8dp"
    app:cardCornerRadius="22dp"
    app:cardElevation="2dp"
    app:strokeWidth="1dp"
    app:strokeColor="#E2E8F0"
    app:cardBackgroundColor="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Hospital Name -->
        <TextView
            android:id="@+id/tvHospitalName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nandadeep Eye Hospital"
            android:textColor="#0F172A"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- Formatted Street Address -->
        <TextView
            android:id="@+id/tvHospitalAddress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="107, Dattawad Renaissance, New Shahupuri"
            android:textColor="#64748B"
            android:textSize="12sp"
            android:maxLines="2"
            android:ellipsize="end" />

        <!-- Bottom Action Row: Distance Badge & Get Directions Button -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp">

            <!-- Distance Pill -->
            <TextView
                android:id="@+id/tvDistanceBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:background="@drawable/bg_distance_pill"
                android:paddingHorizontal="12dp"
                android:paddingVertical="5dp"
                android:text="0.3 km away"
                android:textColor="#0284C7"
                android:textSize="11sp"
                android:textStyle="bold" />

            <!-- Get Directions Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnGetDirections"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:text="Get Directions"
                android:textColor="#0284C7"
                android:textSize="12sp"
                android:textStyle="bold"
                app:cornerRadius="19dp"
                app:strokeColor="#0284C7"
                app:strokeWidth="1.2dp" />
        </RelativeLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>