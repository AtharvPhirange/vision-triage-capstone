    <string name="guide_subtitle">Step-by-step operation &amp; diagnostic workflow</string>
    <string name="guide_step1_badge">STEP 1 - OVERVIEW</string>
    <string name="guide_step1_title">App Overview &amp; Portals</string>
    <string name="guide_step1_desc">Vision Triage connects Patients, Technicians, and Consultants in a single unified pipeline. Select your role from the dashboard to access dedicated features.</string>
    <string name="guide_step1_bullet1">• Role Pipeline (Patient / Tech / Doctor)</string>
    <string name="guide_step1_bullet2">• Local HIPAA &amp; ABDM Security</string>
    <string name="guide_step1_item4_title">Secure &amp; Local Data</string>
    <string name="guide_step1_item4_desc">Your health data never leaves your device without your explicit consent.</string>

    <string name="guide_step2_badge">STEP 2</string>
    <string name="guide_step2_title">How to Scan</string>
    <string name="guide_step2_desc">Position camera 25-30 cm from patient\'s eye. Ensure uniform ambient lighting and lock crosshairs on the pupil center before initiating light stimulation.</string>
    <string name="guide_step2_bullet1">• 25–30 cm Target Lock</string>
    <string name="guide_step2_bullet2">• Pupil Center Crosshair Alignment</string>
    <string name="guide_step2_item1_title">Distance Lock</string>
    <string name="guide_step2_item1_desc">Maintain a steady 25-30 cm gap from the patient\'s eye.</string>
    <string name="guide_step2_item2_title">Aesthetic Target</string>
    <string name="guide_step2_item2_desc">Align crosshairs precisely on the pupil center.</string>
    <string name="guide_step2_item3_title">Lighting Control</string>
    <string name="guide_step2_item3_desc">Ensure uniform ambient lighting without harsh glare.</string>
    <string name="guide_step2_item4_title">Detection Lock</string>
    <string name="guide_step2_item4_desc">Ensure live AI tracking confidence stays above 95%.</string>

    <string name="guide_step3_badge">STEP 3</string>
    <string name="guide_step3_title">Capture PLR</string>
    <string name="guide_step3_desc">Run the 5-second automated pupillary light reflex sweep. Keep hands steady until the AI confidence score reaches 95%+.</string>
    <string name="guide_step3_bullet1">• 5s Automated Reflex Sweep</string>
    <string name="guide_step3_bullet2">• 95%+ AI Confidence Threshold</string>
    <string name="guide_step3_item1_title">Baseline Record</string>
    <string name="guide_step3_item1_desc">Captures resting pupil diameter during the initial 1-second phase.</string>
    <string name="guide_step3_item2_title">Light Stimulation</string>
    <string name="guide_step3_item2_desc">Fires controlled flash pulse to observe constriction velocity.</string>
    <string name="guide_step3_item3_title">Recovery Tracking</string>
    <string name="guide_step3_item3_desc">Measures redilation speed and latency response curves.</string>
    <string name="guide_step3_item4_title">Quality Verification</string>
    <string name="guide_step3_item4_desc">Saves record once confidence reaches 95%+ threshold.</string>

    <string name="guide_step4_badge">STEP 4</string>
    <string name="guide_step4_title">Check Status</string>
    <string name="guide_step4_desc">Instant triage classification: Green (Normal), Amber (Observation), or Red (Urgent Escalation). View full PLR latency graphs under history.</string>
    <string name="guide_step4_bullet1">• Tri-Color Risk Classification</string>
    <string name="guide_step4_bullet2">• Kinematic Latency Graphs</string>
    <string name="guide_step4_item1_title">Green (Normal)</string>
    <string name="guide_step4_item1_desc">Symmetric pupil response with normal constriction speed.</string>
    <string name="guide_step4_item2_title">Amber (Observation)</string>
    <string name="guide_step4_item2_desc">Sluggish reflex or minor asymmetry requiring follow-up.</string>
    <string name="guide_step4_item3_title">Red (Urgent)</string>
    <string name="guide_step4_item3_desc">Fixed, dilated, or non-reactive pupil requiring escalation.</string>
    <string name="guide_step4_item4_title">Latency Graphs</string>
    <string name="guide_step4_item4_desc">Access detailed PLR latency waveforms under Medical History.</string>

    <string name="guide_step5_badge">STEP 5</string>
    <string name="guide_step5_title">Consultant Review</string>
    <string name="guide_step5_desc">Escalate high-risk cases directly to the Consultant Priority Queue with one tap for tele-ophthalmology verification.</string>
    <string name="guide_step5_bullet1">• 1-Tap Queue Escalation</string>
    <string name="guide_step5_bullet2">• Tele-Ophthalmology Verification</string>
    <string name="guide_step5_item1_title">Flag High-Risk</string>
    <string name="guide_step5_item1_desc">High-risk red cases automatically enter the review queue.</string>
    <string name="guide_step5_item2_title">Waveform Analysis</string>
    <string name="guide_step5_item2_desc">Consultants review high-frequency PLR graphs and ratios.</string>
    <string name="guide_step5_item3_title">Verification Tag</string>
