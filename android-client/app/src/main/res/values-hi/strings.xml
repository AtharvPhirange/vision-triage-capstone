    <string name="guide_header_title">क्लिनिकल उपयोगकर्ता गाइड</string>
    <string name="guide_header_subtitle">चरण-दर-चरण संचालन और निदान प्रक्रिया</string>
    <string name="guide_title">क्लिनिकल उपयोगकर्ता गाइड</string>
    <string name="guide_subtitle">चरण-दर-चरण संचालन और निदान प्रक्रिया</string>
    <string name="guide_step1_badge">चरण 1 - अवलोकन</string>
    <string name="guide_step1_title">ऐप अवलोकन और पोर्टल्स</string>
    <string name="guide_step1_desc">विजन ट्राइएज मरीजों, तकनीशियनों और सलाहकारों को एक एकीकृत पाइपलाइन में जोड़ता है। समर्पित सुविधाओं तक पहुँचने के लिए डैशबोर्ड से अपनी भूमिका चुनें।</string>
    <string name="guide_step1_bullet1">&#8226; भूमिका पाइपलाइन (मरीज / टेक / डॉक्टर)</string>
    <string name="guide_step1_bullet2">&#8226; स्थानीय HIPAA और ABDM सुरक्षा</string>
    <string name="guide_step1_item4_title">सुरक्षित एवं स्थानीय डेटा</string>
    <string name="guide_step1_item4_desc">आपका स्वास्थ्य डेटा आपकी स्पष्ट सहमति के बिना आपके डिवाइस से कभी बाहर नहीं जाता।</string>

    <string name="guide_step2_badge">चरण 2</string>
    <string name="guide_step2_title">स्कैन कैसे करें</string>
    <string name="guide_step2_desc">कैमरे को मरीज की आंख से 25-30 सेमी दूर रखें। समान प्रकाश व्यवस्था सुनिश्चित करें और प्रकाश उत्तेजना शुरू करने से पहले पुतली केंद्र पर क्रॉसहेयर लॉक करें।</string>
    <string name="guide_step2_bullet1">&#8226; 25&#8211;30 सेमी लक्ष्य लॉक</string>
    <string name="guide_step2_bullet2">&#8226; पुतली केंद्र संरेखण</string>
    <string name="guide_step2_item1_title">दूरी लॉक</string>
    <string name="guide_step2_item1_desc">मरीज की आंख से 25-30 सेमी की स्थिर दूरी बनाए रखें।</string>
    <string name="guide_step2_item2_title">लक्ष्य संरेखण</string>
    <string name="guide_step2_item2_desc">पुतली के केंद्र पर क्रॉसहेयर को सटीक रूप से मिलाएं।</string>
    <string name="guide_step2_item3_title">प्रकाश नियंत्रण</string>
    <string name="guide_step2_item3_desc">तेज चमक के बिना समान परिवेश प्रकाश व्यवस्था सुनिश्चित करें।</string>
    <string name="guide_step2_item4_title">डिटेक्शन लॉक</string>
    <string name="guide_step2_item4_desc">सुनिश्चित करें कि एआई ट्रैकिंग सटीकता 95%+ से ऊपर रहे।</string>

    <string name="guide_step3_badge">चरण 3</string>
    <string name="guide_step3_title">पीएलआर कैप्चर करें</string>
    <string name="guide_step3_desc">5-सेकंड का स्वचालित प्यूपिलरी लाइट रिफ्लेक्स स्वीप चलाएं। जब तक एआई विश्वास स्कोर 95%+ तक न पहुंच जाए, हाथ स्थिर रखें।</string>
    <string name="guide_step3_bullet1">&#8226; 5 से० स्वचालित रिफ्लेक्स स्वीप</string>
    <string name="guide_step3_bullet2">&#8226; 95%+ एआई विश्वास सीमा</string>
    <string name="guide_step3_item1_title">बेसलाइन रिकॉर्ड</string>
    <string name="guide_step3_item1_desc">शुरुआती 1-सेकंड चरण के दौरान पुतली का व्यास कैप्चर करता है।</string>
    <string name="guide_step3_item2_title">प्रकाश उत्तेजना</string>
    <string name="guide_step3_item2_desc">आकुंचन गति का निरीक्षण करने के लिए फ़्लैश पल्स चलाता है।</string>
    <string name="guide_step3_item3_title">रिकवरी ट्रैकिंग</string>
    <string name="guide_step3_item3_desc">पुनः फैलाव गति और लेटेंसी प्रतिक्रिया वक्र मापता है।</string>
    <string name="guide_step3_item4_title">गुणवत्ता सत्यापन</string>
    <string name="guide_step3_item4_desc">विश्वास स्कोर 95%+ तक पहुंचने पर रिकॉर्ड सहेजता है।</string>

    <string name="guide_step4_badge">चरण 4</string>
    <string name="guide_step4_title">स्थिति जांचें</string>
    <string name="guide_step4_desc">त्वरित ट्राइएज वर्गीकरण: हरा (सामान्य), अंबर (अवलोकन), या लाल (तत्काल एस्केलेशन)। इतिहास के तहत पूर्ण पीएलआर लेटेंसी ग्राफ देखें।</string>
    <string name="guide_step4_bullet1">&#8226; त्रि-रंग जोखिम वर्गीकरण</string>
    <string name="guide_step4_bullet2">&#8226; काइनेमैटिक लेटेंसी ग्राफ</string>
    <string name="guide_step4_item1_title">हरा (सामान्य)</string>
    <string name="guide_step4_item1_desc">सामान्य आकुंचन गति के साथ सममित पुतली प्रतिक्रिया।</string>
    <string name="guide_step4_item2_title">अंबर (अवलोकन)</string>
    <string name="guide_step4_item2_desc">धीमी प्रतिक्रिया या मामूली असमानता जिसे जांच की आवश्यकता है।</string>
    <string name="guide_step4_item3_title">लाल (तत्काल)</string>
    <string name="guide_step4_item3_desc">अप्रतिसादी या स्थिर पुतली जिसे तत्काल एस्केलेशन की आवश्यकता है।</string>
    <string name="guide_step4_item4_title">लेटेंसी ग्राफ</string>
    <string name="guide_step4_item4_desc">मेडिकल इतिहास के तहत विस्तृत पीएलआर लेटेंसी तरंग रूप देखें।</string>

    <string name="guide_step5_badge">चरण 5</string>
    <string name="guide_step5_title">कंसल्टेंट समीक्षा</string>
    <string name="guide_step5_desc">टेली-नेत्र विज्ञान सत्यापन के लिए एक टैप में उच्च जोखिम वाले मामलों को सीधे सलाहकार प्राथमिकता कतार में भेजें।</string>
    <string name="guide_step5_bullet1">&#8226; 1-टैप कतार एस्केलेशन</string>
    <string name="guide_step5_bullet2">&#8226; टेली-नेत्र विज्ञान सत्यापन</string>
    <string name="guide_step5_item1_title">उच्च जोखिम चिंहाकन</string>
    <string name="guide_step5_item1_desc">उच्च जोखिम वाले लाल मामले स्वचालित रूप से समीक्षा कतार में जाते हैं।</string>
    <string name="guide_step5_item2_title">वेवफॉर्म विश्लेषण</string>
    <string name="guide_step5_item2_desc">सलाहकार उच्च-आवृत्ति पीएलआर ग्राफ और अनुपातों की समीक्षा करते हैं।</string>
    <string name="guide_step5_item3_title">सत्यापन टैग</string>
    <string name="guide_step5_item3_desc">क्लिनिकल नोट्स जोड़ें और रिपोर्ट सत्यापित करें।</string>
    <string name="guide_step5_item4_title">रोगी डिस्पैच</string>
    <string name="guide_step5_item4_desc">सत्यापित ट्राइएज सारांश सीधे मरीज प्रोफ़ाइल पर भेजें।</string>

